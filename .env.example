# ---------------------------------------------------------------------------
# Verde — variáveis de ambiente
# Copie para `.env` e ajuste os valores. NUNCA comite o `.env`.
# ---------------------------------------------------------------------------

# Porta HTTP do app (também usada pelo docker-compose)
PORT=3000

# Imagem de produção publicada pelo GitHub Actions no GHCR.
# Para build local, use docker-compose.dev.yml.
VERDE_IMAGE=ghcr.io/tiago-txt/verde:latest

# Pasta de dados no host (SQLite + backups). Padrão: ./data
VERDE_DATA_DIR=./data

# Popula o banco com dados de exemplo no primeiro boot (idempotente).
# Use apenas em desenvolvimento/homologação.
SEED_DEMO=false

# Fuso horário usado para "hoje", fechamento de fatura e geração de recorrências
TZ=America/Sao_Paulo

# Segredo para assinar o cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use no mínimo 32 caracteres. Trocar este valor desloga todos os usuários.
SESSION_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres

# Primeiro usuário (admin), criado automaticamente no primeiro boot.
# Depois disso o admin cria os demais usuários pela interface.
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=troque-esta-senha-forte
ADMIN_NAME=Administrador

# Força o cookie de sessão como Secure. Normalmente não é necessário:
# o app detecta HTTPS pelo header x-forwarded-proto do reverse proxy.
# Defina "true" apenas se o TLS for terminado de outra forma.
COOKIE_SECURE=false

# Caminho do banco SQLite.
# Local (npm run dev): ./data/verde.db
# Docker: /app/data/verde.db (o compose já define; não precisa alterar aqui)
DATABASE_PATH=./data/verde.db

# Backups: quantos arquivos manter em ./data/backups
BACKUP_KEEP=14
